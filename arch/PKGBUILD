# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-api-git
pkgver=4.0.6
pkgrel=1
pkgdesc='D-Bus interfaces and helpers for miscellaneous GXDE desktop services'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-api"
license=('GPL-3.0-or-later')
# alsa-utils: sound-theme-player 使用 alsactl ・ alsactl used in sound-theme-player
# bc/fontconfig/librsvg: adjust-grub-theme 调用 bc、fc-match、rsvg-convert ・ used by adjust-grub-theme
# util-linux: device 调用 rfkill ・ rfkill used in device
# xcur2png: 光标缩略图 ・ cursor thumbnails
depends=('alsa-utils' 'bc' 'fontconfig' 'librsvg' 'util-linux' 'coreutils' 'blur-effect'
         'xcur2png' 'libcanberra' 'libpulse' 'glib2' 'gtk3' 'gdk-pixbuf2' 'gdk-pixbuf-xlib' 'cairo'
         'freetype2' 'poppler-glib' 'libxi' 'libx11' 'libgudev' 'noto-fonts-cjk' 'glibc')
makedepends=('git' 'go' 'deepin-gettext-tools' 'golang-gxde-dev-git')
provides=('deepin-api')
conflicts=('deepin-api')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  export CGO_CPPFLAGS="${CPPFLAGS}"
  # go-gir 生成的 C 代码使用无参数原型 f()，在 GCC 默认的 C23 下会冲突
  # The C code generated by go-gir uses empty prototypes f(), which clash
  # under GCC's default C23.
  export CGO_CFLAGS="${CFLAGS} -std=gnu17"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  # 仍是 GOPATH 模式，不能使用 -mod ・ Still GOPATH mode, so no -mod flag.
  export GOFLAGS="-buildmode=pie -trimpath"
  export GO111MODULE=off
  make -C "$(_srcroot)"
}

package() {
  # Arch 没有 /lib ・ Arch has no /lib.
  make -C "$(_srcroot)" DESTDIR="$pkgdir" SYSTEMD_LIB_DIR=/usr/lib install
}
